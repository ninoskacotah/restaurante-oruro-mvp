# Entorno: development, test o production
APP_ENV=development

# Sustituir todos los valores siguientes en el archivo .env local
DATABASE_URL=postgresql+psycopg://restaurant_user:replace-with-local-password@localhost:5432/restaurant_las_retamas
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
JWT_SECRET=replace-with-random-secret-at-least-32-characters
MEDIA_ROOT=var/media
PAYMENT_QR_PATH=var/payment-qr.png
